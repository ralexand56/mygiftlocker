    "aws-cdk-lib": "^2.220.0",
    "constructs": "^10.4.2",
    "esbuild": "0.25.12",
    "turbo": "^2.11.13",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@anthropic-ai/bedrock-sdk": "^1.1.3",
    "@anthropic-ai/sdk": "^1.14.0",
    "@mgl/core": "workspace:*",
