{
  "expo": {
    "name": "M Gift Locker",
    "slug": "mygiftlocker",
    "version": "0.1.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mygiftlocker.app",
      "associatedDomains": [
        "applinks:mygiftlocker.com"
      ]
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFAF7",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.mygiftlocker.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font"
    ],
    "scheme": "mygiftlocker",
    "experiments": {
      "typedRoutes": true
    }
  }
}
